# Copie este arquivo para ".env.local" (na raiz do projeto, ao lado do package.json)
# e preencha com os valores reais do seu projeto Firebase.
#
# Onde encontrar os valores:
# console.firebase.google.com > seu projeto > ícone de engrenagem (Configurações do projeto)
# > aba "Geral" > seção "Seus apps" > app Web > "Configuração do SDK"
#
# IMPORTANTE: o arquivo ".env.local" NUNCA deve ser commitado no Git
# (deve estar no .gitignore). Ele é só para rodar o projeto na sua máquina.
# No Vercel, essas mesmas variáveis são cadastradas em
# Settings > Environment Variables, separadamente.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
